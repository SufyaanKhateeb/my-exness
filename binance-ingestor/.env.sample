# Shared app / callback URL
# Optional for the ingestor itself, but often kept aligned with the frontend project.
APP_BASE_URL=http://localhost:3000

# Auth0 M2M / tenant configuration
# AUTH0_DOMAIN, AUTH0_CLIENT_ID, and AUTH0_CLIENT_SECRET are required.
# The ingestor will use SPACETIMEDB_INGEST_CLIENT_ID / SPACETIMEDB_INGEST_CLIENT_SECRET if provided,
# otherwise it falls back to AUTH0_CLIENT_ID / AUTH0_CLIENT_SECRET.
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-auth0-machine-to-machine-client-id
AUTH0_CLIENT_SECRET=your-auth0-machine-to-machine-client-secret

# Optional if your local tooling also expects the frontend-style secret/session settings.
AUTH0_SECRET=replace-with-64-char-hex-secret

# Auth0 API / scopes
# AUTH0_AUDIENCE is optional.
# Default in ingestor config: https://my-exness-spacetimedb
AUTH0_AUDIENCE=https://my-exness-spacetimedb

# Optional.
# If omitted, the ingestor will still append market:ingest automatically.
AUTH0_SCOPE=openid profile email simulation:reset

# Optional override for the exact ingest scope.
# If omitted, the ingestor derives scope from AUTH0_SCOPE and guarantees market:ingest is included.
SPACETIMEDB_INGEST_SCOPE=market:ingest

# Optional dedicated M2M credentials for ingestion.
# Defaults to AUTH0_CLIENT_ID / AUTH0_CLIENT_SECRET when omitted.
SPACETIMEDB_INGEST_CLIENT_ID=
SPACETIMEDB_INGEST_CLIENT_SECRET=

# SpacetimeDB connection target
# Optional.
# Defaults in ingestor config:
# SPACETIMEDB_HOST=ws://localhost:3000
# SPACETIMEDB_DB_NAME=nextjs-ts
# The ingestor also falls back to NEXT_PUBLIC_SPACETIMEDB_HOST / NEXT_PUBLIC_SPACETIMEDB_DB_NAME if set.
SPACETIMEDB_HOST=http://localhost:4000
SPACETIMEDB_DB_NAME=next-exness-p83i0

# Optional browser-style fallbacks used by the ingestor if SPACETIMEDB_HOST / SPACETIMEDB_DB_NAME are omitted.
NEXT_PUBLIC_SPACETIMEDB_HOST=http://localhost:4000
NEXT_PUBLIC_SPACETIMEDB_DB_NAME=next-exness-p83i0

# Optional browser-style Auth0 audience fallback used by the ingestor.
NEXT_PUBLIC_AUTH0_AUDIENCE=https://my-exness-spacetimedb

# SpacetimeDB module runtime mode
# Optional.
# Set to external when the module should accept external market ingestion.
SPACETIMEDB_MARKET_DATA_MODE=external

# Binance endpoints
# Optional.
# Defaults in ingestor config:
# BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/stream
# BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/stream
BINANCE_REST_BASE_URL=https://api.binance.com

# Binance markets to ingest
# Optional.
# Default in ingestor config: btcusdt,ethusdt,solusdt
BINANCE_SYMBOLS=btcusdt,ethusdt,solusdt

# Order book / reconnect behavior
# Optional.
# Defaults in ingestor config:
# BINANCE_ORDER_BOOK_LEVELS=20
# BINANCE_RECONNECT_DELAY_MS=5000
# BINANCE_STALE_MESSAGE_TIMEOUT_MS=90000
BINANCE_ORDER_BOOK_LEVELS=20
BINANCE_RECONNECT_DELAY_MS=5000
BINANCE_STALE_MESSAGE_TIMEOUT_MS=90000

# Reducer batching / flush behavior
# Optional.
# Defaults in ingestor config:
# BINANCE_REDUCER_FLUSH_INTERVAL_MS=750
# BINANCE_REDUCER_FLUSH_JITTER_MS=150
BINANCE_REDUCER_FLUSH_INTERVAL_MS=750
BINANCE_REDUCER_FLUSH_JITTER_MS=150

# Session lifecycle / historical seeding
# Optional.
# Defaults in ingestor config:
# BINANCE_SESSION_MAX_LIFETIME_MS=82800000
# BINANCE_HISTORY_SEED_DAYS=3
# BINANCE_HISTORY_SEED_CHUNK_SIZE=500
BINANCE_SESSION_MAX_LIFETIME_MS=82800000
BINANCE_HISTORY_SEED_DAYS=3
BINANCE_HISTORY_SEED_CHUNK_SIZE=500