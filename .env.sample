# Frontend app URL
# Required for local Auth0 callback/logout configuration.
APP_BASE_URL=http://localhost:3000

# Auth0 app credentials
# Required.
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-auth0-application-client-id
AUTH0_CLIENT_SECRET=your-auth0-application-client-secret

# Auth0 session encryption secret
# Required.
# Generate with: openssl rand -hex 32
AUTH0_SECRET=replace-with-64-char-hex-secret

# Auth0 API / scopes
# AUTH0_AUDIENCE is optional for the frontend server layer if you do not need a custom API audience,
# but keep it aligned with NEXT_PUBLIC_AUTH0_AUDIENCE when using SpacetimeDB/Auth0 integration.
AUTH0_AUDIENCE=https://my-exness-spacetimedb

# Optional.
# Default in app code: undefined
AUTH0_SCOPE=openid profile email simulation:reset

# Public Auth0 values exposed to the browser
# NEXT_PUBLIC_AUTH0_AUDIENCE is optional.
# Default in app code: undefined
NEXT_PUBLIC_AUTH0_AUDIENCE=https://my-exness-spacetimedb

# Optional.
# Default in app code: undefined
NEXT_PUBLIC_AUTH0_SCOPE=openid profile email simulation:reset

# SpacetimeDB server-side access
# Optional.
# Defaults in app code:
# SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
# SPACETIMEDB_DB_NAME=nextjs-ts
SPACETIMEDB_HOST=http://localhost:4000
SPACETIMEDB_DB_NAME=next-exness-p83i0

# SpacetimeDB browser/client access
# Optional.
# Defaults in app code:
# NEXT_PUBLIC_SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
# NEXT_PUBLIC_SPACETIMEDB_DB_NAME=nextjs-ts
NEXT_PUBLIC_SPACETIMEDB_HOST=http://localhost:4000
NEXT_PUBLIC_SPACETIMEDB_DB_NAME=next-exness-p83i0

# SpacetimeDB module runtime mode
# Optional.
# Set to external when using the Binance ingestor instead of simulator-driven market data.
SPACETIMEDB_MARKET_DATA_MODE=external